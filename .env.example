# ==============================================================================
# TaskFlow AI - Production Environment Configuration Template
# Copy this file to '.env' and populate with your environment-specific values.
# NEVER commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Django Settings
# ------------------------------------------------------------------------------
# In production, set DEBUG=False. In local development, set DEBUG=True.
DEBUG=True

# In production (DEBUG=False), SECRET_KEY is MANDATORY and must be a unique,
# cryptographically random string (min 50 characters, no 'django-insecure-' prefix).
# Example to generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key-for-production

# Comma-separated list of host/domain names that this Django site can serve.
# Required in production. In local development (DEBUG=True), defaults to '*'.
ALLOWED_HOSTS=localhost,127.0.0.1,example.com,app.example.com

# Comma-separated list of trusted origins for unsafe requests (e.g. POST form submissions).
# Required when accessing via HTTPS behind reverse proxies or load balancers.
CSRF_TRUSTED_ORIGINS=https://example.com,https://app.example.com

# Optional admin registration code to restrict staff account creation.
# Leave empty to disable admin registration.
ADMIN_REGISTRATION_CODE=

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# TaskFlow defaults to SQLite ('db.sqlite3') when neither DATABASE_URL nor
# POSTGRES_* variables are set.
#
# Option A: Full Connection URL (PostgreSQL or SQLite)
# DATABASE_URL=postgresql://taskflow_user:strong_password@localhost:5432/taskflow_db
#
# Option B: Individual PostgreSQL parameters
# POSTGRES_DB=taskflow_db
# POSTGRES_USER=taskflow_user
# POSTGRES_PASSWORD=strong_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# CONN_MAX_AGE=600

# ------------------------------------------------------------------------------
# HTTPS & Security Headers (Active when DEBUG=False)
# ------------------------------------------------------------------------------
# Redirect all HTTP requests to HTTPS (default: True in production).
# If SSL termination happens upstream at a reverse proxy/load balancer, ensure
# X-Forwarded-Proto header is passed. Set to False only in container internal nets.
SECURE_SSL_REDIRECT=True

# HTTP Strict Transport Security (HSTS) duration in seconds (default: 31536000 = 1 year).
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ------------------------------------------------------------------------------
# Google Gemini AI Assistant Configuration
# ------------------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash
# Optional agent guardrail overrides:
# TASKFLOW_AI_MAX_ROUNDS=10
# TASKFLOW_AI_MAX_TOOL_CALLS=20

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
# Application log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
